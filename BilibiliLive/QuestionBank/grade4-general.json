    {"question_id": "G4M-025", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "数学", "textbookVersion": "general_knowledge", "chapter": "小数的意义和性质", "knowledgePoints": ["小数点移动规律"], "difficulty": "medium", "prompt": "把 4.05 的小数点去掉，这个数就扩大到原来的多少倍？", "type": "single_choice", "options": [{"id": "A", "text": "100 倍"}, {"id": "B", "text": "10 倍"}, {"id": "C", "text": "大小不变"}, {"id": "D", "text": "1000 倍"}], "answer": "A", "explanation": "4.05 去掉小数点变成 405，405÷4.05=100，扩大到原来的 100 倍。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4M-026", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "数学", "textbookVersion": "general_knowledge", "chapter": "小数的意义和性质", "knowledgePoints": ["求小数近似数"], "difficulty": "medium", "prompt": "用四舍五入法把 3.56 保留一位小数，约是多少？", "type": "single_choice", "options": [{"id": "A", "text": "3.6"}, {"id": "B", "text": "4.0"}, {"id": "C", "text": "3.5"}, {"id": "D", "text": "3.56"}], "answer": "A", "explanation": "看百分位是 6，满 5 向十分位进 1，约是 3.6。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4M-027", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "数学", "textbookVersion": "general_knowledge", "chapter": "小数的意义和性质", "knowledgePoints": ["小数的基本性质"], "difficulty": "medium", "prompt": "0.6 和 0.60 相比较，结论是什么？", "type": "single_choice", "options": [{"id": "A", "text": "大小相等，计数单位不同"}, {"id": "B", "text": "0.6 更大"}, {"id": "C", "text": "无法比较"}, {"id": "D", "text": "0.60 更大"}], "answer": "A", "explanation": "小数末尾添 0 或去 0 大小不变，但 0.6 的计数单位是 0.1，0.60 是 0.01。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
