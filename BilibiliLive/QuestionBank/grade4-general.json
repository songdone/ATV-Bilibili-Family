    {"question_id": "G4E-005", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "英语", "textbookVersion": "general_knowledge", "chapter": "语法", "knowledgePoints": ["名词复数"], "difficulty": "medium", "prompt": "one box, two ___？", "type": "single_choice", "options": [{"id": "A", "text": "box"}, {"id": "B", "text": "boxies"}, {"id": "C", "text": "boxes"}, {"id": "D", "text": "boxs"}], "answer": "C", "explanation": "以 x 结尾的名词变复数加 es：box→boxes。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4E-006", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "英语", "textbookVersion": "general_knowledge", "chapter": "句型", "knowledgePoints": ["疑问词"], "difficulty": "easy", "prompt": "询问对方的名字：___ your name?", "type": "single_choice", "options": [{"id": "A", "text": "Who's"}, {"id": "B", "text": "What's"}, {"id": "C", "text": "Where's"}, {"id": "D", "text": "How's"}], "answer": "B", "explanation": "What's your name? 意思是“你叫什么名字？”", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4E-007", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "英语", "textbookVersion": "general_knowledge", "chapter": "词汇", "knowledgePoints": ["服装与天气"], "difficulty": "medium", "prompt": "It's cold. Put on your ___（外套）。", "type": "single_choice", "options": [{"id": "A", "text": "skirt"}, {"id": "B", "text": "coat"}, {"id": "C", "text": "shorts"}, {"id": "D", "text": "T-shirt"}], "answer": "B", "explanation": "天冷要穿外套，外套是 coat。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4E-008", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "英语", "textbookVersion": "general_knowledge", "chapter": "句型", "knowledgePoints": ["天气问句"], "difficulty": "medium", "prompt": "问今天的天气：___ the weather like today?", "type": "single_choice", "options": [{"id": "A", "text": "How's"}, {"id": "B", "text": "Where's"}, {"id": "C", "text": "Who's"}, {"id": "D", "text": "What's"}], "answer": "D", "explanation": "What's the weather like? 是询问天气的常用句型。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4E-009", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "英语", "textbookVersion": "general_knowledge", "chapter": "词汇", "knowledgePoints": ["短语意思"], "difficulty": "easy", "prompt": "“go to school”是什么意思？", "type": "single_choice", "options": [{"id": "A", "text": "回家"}, {"id": "B", "text": "去公园"}, {"id": "C", "text": "去上学"}, {"id": "D", "text": "去睡觉"}], "answer": "C", "explanation": "school 是学校，go to school 就是去上学。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4E-010", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "英语", "textbookVersion": "general_knowledge", "chapter": "句型", "knowledgePoints": ["一般疑问句回答"], "difficulty": "hard", "prompt": "Is this your bag? 的规范肯定简短回答是哪一个？", "type": "single_choice", "options": [{"id": "A", "text": "Yes, it is."}, {"id": "B", "text": "Yes, it isn't."}, {"id": "C", "text": "Yes, this is."}, {"id": "D", "text": "No, it is."}], "answer": "A", "explanation": "用 Is this…? 提问，肯定回答用 Yes, it is.", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4S-001", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "科学", "textbookVersion": "general_knowledge", "chapter": "声音", "knowledgePoints": ["声音的产生"], "difficulty": "easy", "prompt": "声音是怎么产生的？", "type": "single_choice", "options": [{"id": "A", "text": "电流流动产生的"}, {"id": "B", "text": "光照射产生的"}, {"id": "C", "text": "物体静止不动产生的"}, {"id": "D", "text": "物体振动产生的"}], "answer": "D", "explanation": "发声物体的振动产生声音。振动停止，它就不再继续发声；已经传播出去的声音仍可能稍后到达耳朵。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4S-002", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "科学", "textbookVersion": "general_knowledge", "chapter": "呼吸与消化", "knowledgePoints": ["呼吸气体"], "difficulty": "easy", "prompt": "人体通过呼吸从空气中获取、用于维持生命活动的气体主要是哪一种？", "type": "single_choice", "options": [{"id": "A", "text": "氧气"}, {"id": "B", "text": "氢气"}, {"id": "C", "text": "水蒸气"}, {"id": "D", "text": "二氧化碳"}], "answer": "A", "explanation": "人体利用吸入空气中的氧气，并排出生命活动产生的二氧化碳。吸入和呼出的都是混合气体，呼出气体仍含较多氮气和氧气，并不是纯二氧化碳。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4S-003", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "科学", "textbookVersion": "general_knowledge", "chapter": "呼吸与消化", "knowledgePoints": ["营养与消化"], "difficulty": "medium", "prompt": "米饭、馒头中，主要为身体提供能量的成分是哪一种？", "type": "single_choice", "options": [{"id": "A", "text": "维生素"}, {"id": "B", "text": "淀粉"}, {"id": "C", "text": "脂肪"}, {"id": "D", "text": "水"}], "answer": "B", "explanation": "米饭、馒头富含淀粉（属于碳水化合物），消化后可为身体提供能量；它们也含有水分等其他成分。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4S-004", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "科学", "textbookVersion": "general_knowledge", "chapter": "呼吸与消化", "knowledgePoints": ["消化器官"], "difficulty": "medium", "prompt": "消化过程中，吸收营养的主要器官是？", "type": "single_choice", "options": [{"id": "A", "text": "口腔"}, {"id": "B", "text": "胃"}, {"id": "C", "text": "小肠"}, {"id": "D", "text": "大肠"}], "answer": "C", "explanation": "小肠又长又有绒毛，是吸收营养的主要场所。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4S-005", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "科学", "textbookVersion": "general_knowledge", "chapter": "运动与力", "knowledgePoints": ["磁铁性质"], "difficulty": "easy", "prompt": "磁铁能吸引下面哪种材料？", "type": "single_choice", "options": [{"id": "A", "text": "木头"}, {"id": "B", "text": "铁"}, {"id": "C", "text": "玻璃"}, {"id": "D", "text": "塑料"}], "answer": "B", "explanation": "磁铁能吸引铁一类的磁性材料，不能吸引木头、塑料和玻璃。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4S-006", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "科学", "textbookVersion": "general_knowledge", "chapter": "植物的生长", "knowledgePoints": ["植物生长条件"], "difficulty": "easy", "prompt": "绿色植物生长一般需要阳光、空气和？", "type": "single_choice", "options": [{"id": "A", "text": "塑料"}, {"id": "B", "text": "音乐"}, {"id": "C", "text": "水分"}, {"id": "D", "text": "巧克力"}], "answer": "C", "explanation": "植物生长需要阳光、空气、水分和适宜的温度等条件。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4S-007", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "科学", "textbookVersion": "general_knowledge", "chapter": "能源与生活", "knowledgePoints": ["可再生能源"], "difficulty": "medium", "prompt": "下面属于可再生能源的是？", "type": "single_choice", "options": [{"id": "A", "text": "太阳能"}, {"id": "B", "text": "天然气"}, {"id": "C", "text": "石油"}, {"id": "D", "text": "煤"}], "answer": "A", "explanation": "在人类利用的时间尺度内，太阳能可持续获得，属于可再生能源；煤、石油和天然气形成极慢，属于不可再生能源。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4S-008", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "科学", "textbookVersion": "general_knowledge", "chapter": "水的三态变化", "knowledgePoints": ["水结冰"], "difficulty": "medium", "prompt": "在通常的大气压下，同样质量的液态水完全结成冰后，体积与结冰前相比怎样？", "type": "single_choice", "options": [{"id": "A", "text": "不变"}, {"id": "B", "text": "先变小再变大"}, {"id": "C", "text": "变小"}, {"id": "D", "text": "变大"}], "answer": "D", "explanation": "通常条件下，同样质量的水结冰后体积变大，冰的密度比液态水小，所以冰能浮在水面上；装满水的硬瓶结冰时可能被撑裂。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4S-009", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "科学", "textbookVersion": "general_knowledge", "chapter": "月球与星空", "knowledgePoints": ["月相变化"], "difficulty": "hard", "prompt": "月相从新月到下一次新月，大约需要多长时间？", "type": "single_choice", "options": [{"id": "A", "text": "一天"}, {"id": "B", "text": "一周"}, {"id": "C", "text": "一年"}, {"id": "D", "text": "一个月"}], "answer": "D", "explanation": "月相变化一个周期约 29.5 天，大约一个月。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4S-010", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "科学", "textbookVersion": "general_knowledge", "chapter": "食物与营养", "knowledgePoints": ["均衡饮食"], "difficulty": "medium", "prompt": "哪种饮食习惯最科学？", "type": "single_choice", "options": [{"id": "A", "text": "荤素搭配，按时吃饭"}, {"id": "B", "text": "经常不吃早餐"}, {"id": "C", "text": "只吃肉不吃菜"}, {"id": "D", "text": "渴了才喝水，平时只喝饮料"}], "answer": "A", "explanation": "均衡营养、按时用餐才有利于身体健康。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4D-001", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "道德与法治", "textbookVersion": "general_knowledge", "chapter": "安全出行", "knowledgePoints": ["交通规则"], "difficulty": "easy", "prompt": "在设有人行横道和信号灯的路口，过马路应走哪里？", "type": "single_choice", "options": [{"id": "A", "text": "翻越护栏"}, {"id": "B", "text": "机动车道中间"}, {"id": "C", "text": "随便从哪里穿过去"}, {"id": "D", "text": "人行横道（斑马线）"}], "answer": "D", "explanation": "应走人行横道，按行人信号灯通行并观察来车；有过街天桥或地下通道时，也可按现场指示使用。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4D-002", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "道德与法治", "textbookVersion": "general_knowledge", "chapter": "安全自救", "knowledgePoints": ["报警电话"], "difficulty": "easy", "prompt": "在中国大陆，发生火灾时应拨打哪个火警电话？", "type": "single_choice", "options": [{"id": "A", "text": "119"}, {"id": "B", "text": "122"}, {"id": "C", "text": "120"}, {"id": "D", "text": "110"}], "answer": "A", "explanation": "中国大陆火警电话是 119。先远离危险，到安全地点求助并报警，说清地点和情况，不要为打电话耽误逃生。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4D-003", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "道德与法治", "textbookVersion": "general_knowledge", "chapter": "安全自救", "knowledgePoints": ["急救电话"], "difficulty": "easy", "prompt": "在中国大陆，有人受伤需要紧急医疗救治，应拨打哪个急救电话？", "type": "single_choice", "options": [{"id": "A", "text": "120"}, {"id": "B", "text": "114"}, {"id": "C", "text": "110"}, {"id": "D", "text": "119"}], "answer": "A", "explanation": "中国大陆医疗急救电话是 120。应说明地点和伤者情况，并听从急救人员指导。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4D-004", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "道德与法治", "textbookVersion": "general_knowledge", "chapter": "垃圾分类", "knowledgePoints": ["垃圾类别"], "difficulty": "medium", "prompt": "按当地有害垃圾投放指引，废镉镍充电电池（Ni-Cd）应归入哪一类？", "type": "single_choice", "options": [{"id": "A", "text": "可回收物"}, {"id": "B", "text": "其他垃圾"}, {"id": "C", "text": "有害垃圾"}, {"id": "D", "text": "厨余垃圾"}], "answer": "C", "explanation": "废镉镍电池含镉，通常按有害垃圾单独收集；废钮扣电池也应按当地有害垃圾或专门回收指引投放。不能把所有废电池一概归为有害垃圾：常见无汞碱性干电池通常属于其他垃圾。具体分类和投放地点遵守本地规定，不要拆解电池。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4D-005", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "道德与法治", "textbookVersion": "general_knowledge", "chapter": "班级生活", "knowledgePoints": ["值日与责任"], "difficulty": "medium", "prompt": "轮到自己值日时，正确的做法是？", "type": "single_choice", "options": [{"id": "A", "text": "应付了事随便扫扫"}, {"id": "B", "text": "偷偷让别人代做"}, {"id": "C", "text": "认真负责地完成任务"}, {"id": "D", "text": "直接溜走不干"}], "answer": "C", "explanation": "值日是班级成员的责任，应认真完成。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4D-006", "stage": "primary", "system": "6_3", "grade": 4, "semester": "first", "subject": "道德与法治", "textbookVersion": "general_knowledge", "chapter": "同学交往", "knowledgePoints": ["解决矛盾"], "difficulty": "medium", "prompt": "和同学发生矛盾时，正确的做法是？", "type": "single_choice", "options": [{"id": "A", "text": "动手解决"}, {"id": "B", "text": "冷静沟通，必要时请老师帮助"}, {"id": "C", "text": "争吵谩骂"}, {"id": "D", "text": "永远不理对方"}], "answer": "B", "explanation": "遇到矛盾要冷静沟通、互相体谅，解决不了可以请老师帮忙。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4D-007", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "道德与法治", "textbookVersion": "general_knowledge", "chapter": "我们的国家", "knowledgePoints": ["首都"], "difficulty": "easy", "prompt": "中国的首都是哪里？", "type": "single_choice", "options": [{"id": "A", "text": "南京"}, {"id": "B", "text": "广州"}, {"id": "C", "text": "北京"}, {"id": "D", "text": "上海"}], "answer": "C", "explanation": "中国的首都是北京。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4D-008", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "道德与法治", "textbookVersion": "general_knowledge", "chapter": "我们的国家", "knowledgePoints": ["国旗"], "difficulty": "easy", "prompt": "中国的国旗是什么？", "type": "single_choice", "options": [{"id": "A", "text": "红旗白边旗"}, {"id": "B", "text": "彩旗"}, {"id": "C", "text": "蓝色旗帜"}, {"id": "D", "text": "五星红旗"}], "answer": "D", "explanation": "中国的国旗是五星红旗。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4D-009", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "道德与法治", "textbookVersion": "general_knowledge", "chapter": "安全出行", "knowledgePoints": ["乘车安全"], "difficulty": "medium", "prompt": "乘坐配有安全带的小汽车时，下面哪种做法是正确的？", "type": "single_choice", "options": [{"id": "A", "text": "把头伸出窗外看风景"}, {"id": "B", "text": "坐稳扶好，系好安全带"}, {"id": "C", "text": "向车窗外扔垃圾"}, {"id": "D", "text": "在车里大声打闹"}], "answer": "B", "explanation": "应坐稳、正确使用安全带；儿童按身高体重和当地规定使用适合的儿童安全座椅或增高垫，不把身体伸出车窗。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"},
    {"question_id": "G4D-010", "stage": "primary", "system": "6_3", "grade": 4, "semester": "second", "subject": "道德与法治", "textbookVersion": "general_knowledge", "chapter": "勤俭节约", "knowledgePoints": ["珍惜粮食"], "difficulty": "hard", "prompt": "朱用纯《朱子家训》中“一粥一饭，当思来处不易”提醒我们应该怎么做？", "type": "single_choice", "options": [{"id": "A", "text": "珍惜粮食，不浪费食物"}, {"id": "B", "text": "只挑自己爱吃的吃"}, {"id": "C", "text": "想买什么就买什么"}, {"id": "D", "text": "剩饭倒掉没关系"}], "answer": "A", "explanation": "朱用纯（号柏庐）的《朱子家训》用这句话提醒人们粮食来之不易，要珍惜、不浪费；这里引用的是古籍短句，不是现代教材注释。", "sourceBook": null, "sourcePage": null, "reviewStatus": "approved"}
  ]
