{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atv-family:question-bank:1",
  "title": "Offline question bank; test fixtures are never runtime content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bankId", "curriculum", "testOnly", "licenseStatus", "reviewEvidence", "questions"],
  "properties": {
    "schemaVersion": {"const": 1, "type": "integer"},
    "bankId": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "curriculum": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "alignment", "description"],
      "properties": {
        "kind": {"enum": ["general_knowledge", "exact_textbook"]},
        "alignment": {"enum": ["not_exact_textbook", "exact_textbook"]},
        "description": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"kind": {"const": "general_knowledge"}}},
      "then": {"properties": {"alignment": {"const": "not_exact_textbook"}}},
      "else": {"properties": {"alignment": {"const": "exact_textbook"}}}
    },
    "testOnly": {"type": "boolean"},
    "licenseStatus": {"enum": ["needs_review", "cleared", "ai_assessed", "denied", "test_only"]},
    "reviewEvidence": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["reviewedBy", "reviewedAt", "answersVerified", "provenanceVerified", "licenseVerified", "notes", "reviewType", "humanReviewed", "textbookAlignmentVerified", "licenseBasis", "reviewedQuestionIDs", "contentSHA256"],
      "properties": {
        "reviewedBy": {"type": "string", "minLength": 1},
        "reviewedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
        "answersVerified": {"type": "boolean"},
        "provenanceVerified": {"type": "boolean"},
        "licenseVerified": {"type": "boolean"},
        "notes": {"type": "string", "minLength": 1},
        "reviewType": {"enum": ["ai", "human"]},
        "humanReviewed": {"type": "boolean"},
        "textbookAlignmentVerified": {"type": "boolean"},
        "licenseBasis": {"type": "string", "minLength": 1},
        "reviewedQuestionIDs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contentSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "sourceBook": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["repo", "commit", "path", "blobsha", "book_id"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "blobsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "book_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourcePage": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["pdfPage", "printedPage"],
      "properties": {
        "pdfPage": {"type": "integer", "minimum": 1},
        "printedPage": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "stage", "system", "grade", "semester", "subject", "textbookVersion", "chapter", "knowledgePoints", "difficulty", "prompt", "type", "options", "answer", "explanation", "sourceBook", "sourcePage", "reviewStatus"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
        "stage": {"enum": ["primary", "junior_secondary", "senior_secondary", "higher_education", "preschool", "vocational", "special_education", "other", null]},
        "system": {"enum": ["6_3", "5_4", "not_applicable", "other", null]},
        "grade": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
        "semester": {"enum": ["first", "second", "full_year", null]},
        "subject": {"type": ["string", "null"], "minLength": 1},
        "textbookVersion": {"type": ["string", "null"], "minLength": 1},
        "chapter": {"type": ["string", "null"], "minLength": 1},
        "knowledgePoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "difficulty": {"enum": ["easy", "medium", "hard"]},
        "prompt": {"type": "string", "minLength": 1},
        "type": {"enum": ["single_choice", "multiple_choice", "true_false", "short_answer"]},
        "options": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "text"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "answer": {"oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        ]},
        "explanation": {"type": "string", "minLength": 1},
        "sourceBook": {"$ref": "#/$defs/sourceBook"},
        "sourcePage": {"$ref": "#/$defs/sourcePage"},
        "reviewStatus": {"enum": ["draft", "needs_review", "approved", "rejected"]}
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["single_choice", "true_false"]}}},
         "then": {"properties": {"options": {"minItems": 2}, "answer": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "true_false"}}},
         "then": {"properties": {"options": {"maxItems": 2}}}},
        {"if": {"properties": {"type": {"const": "multiple_choice"}}},
         "then": {"properties": {"options": {"minItems": 2}, "answer": {"type": "array"}}}},
        {"if": {"properties": {"type": {"const": "short_answer"}}},
         "then": {"properties": {"options": {"maxItems": 0}, "answer": {"type": "string"}}}}
      ]
    }
  }
}
